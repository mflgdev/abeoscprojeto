RewriteEngine On

# Ignora qualquer arquivo direto dentro de assets (estático, imagens, CSS, JS, etc.)
RewriteCond %{REQUEST_URI} ^/siteinstitucional/assets/ [NC]
RewriteRule ^ - [L]

# Redireciona URLs amigáveis para arquivos PHP dentro de assets/pages
RewriteRule ^quem-somos/?$ assets/pages/quem-somos.php [L,QSA]
RewriteRule ^noticias/?$ assets/pages/noticias.php [L,QSA]
RewriteRule ^noticias/([0-9]+)/?$ assets/pages/noticias.php?id=$1 [L,QSA]  # <- Adicionada esta linha
RewriteRule ^doe/?$ assets/pages/doe.php [L,QSA]
RewriteRule ^envie-seu-curriculo/?$ assets/pages/envie-seu-curriculo.php [L,QSA]
RewriteRule ^transparencia/?$ assets/pages/transparencia.php [L,QSA]

# Rota para /unidade/slug => assets/pages/unidade.php?slug=slug
RewriteRule ^unidade/([^/]+)/?$ assets/pages/unidade.php?slug=$1 [L,QSA]

# Regra genérica (deve ser a última das regras de rota)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)/?$ assets/pages/$1.php [L,QSA]
