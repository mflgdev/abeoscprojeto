# .gitignore

```gitignore
# Dependências
/vendor/
/node_modules/

# Ambiente
.env
.env.local
.env.production

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Sistema
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Uploads gerais
uploads/
public/uploads/
public_uploads/

# Fotos da creche
assets/img/creche/
assets/images/creche/
assets/uploads/creche/

# Notícias
assets/img/noticias/
assets/images/noticias/
assets/uploads/noticias/
noticias/uploads/
news/uploads/

# Cache
/cache/
/tmp/

# Arquivos compactados
*.zip
*.rar